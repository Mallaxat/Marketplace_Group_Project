<Window x:Class="Marketplace_Group_Project.Views.AdminMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:converters="clr-namespace:Marketplace_Group_Project.Converters"
        mc:Ignorable="d"
        Title="Магазин — Продавец"
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
		Background="#F4F6F9"
        FontFamily="Segoe UI">

	<Window.Resources>
		<ResourceDictionary>
			<converters:EnumDescriptionConverter x:Key="enumConverter"/>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/Dictionaries/ViewsDictionary.xaml"/>
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Window.Resources>

	<Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

		<!-- Верхняя панель -->
		<Border Grid.Row="0"
                 Background="{StaticResource SurfaceBrush}"
                 BorderBrush="{StaticResource BorderSoftBrush}"
                 BorderThickness="1"
                 CornerRadius="10"
                 Padding="16,10"
                 Margin="0,0,0,12">
			<DockPanel>
				<Button DockPanel.Dock="Right"
                    Content="Выйти"
                    Width="100" Height="32"
	                Style="{StaticResource GhostButton}"
                    Command="{Binding LogoutCommand}" />
				<TextBlock Text="{Binding CurrentUserName, StringFormat='Продавец: {0}'}"
					   Foreground="{StaticResource TextPrimaryBrush}"
                       VerticalAlignment="Center"
                       FontSize="14" FontWeight="Bold" />
			</DockPanel>
		</Border>

		<TabControl Grid.Row="1">

            <TabItem Header="Товары">
				<Grid Margin="4,12,4,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0"
                            Content="Обновить список"
                            Width="150" Height="35"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,12"
                            Style="{StaticResource BaseButton}"
                            Command="{Binding RefreshProductsCommand}" />

					<DataGrid Grid.Row="1"
							  Name="dtg_products"
                              ItemsSource="{Binding Products}"
                              SelectedItem="{Binding SelectedProduct}"
                              AutoGenerateColumns="False"
                              IsReadOnly="False"
							  TextInput="dtg_products_TextInput"
                              SelectionMode="Single"
							  BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" IsReadOnly="True" Width="2*" />
							<DataGridTextColumn Header="Описание" Binding="{Binding Description}" IsReadOnly="True" Width="3*" />
							<DataGridTextColumn Header="Категория" Binding="{Binding Category, Converter={StaticResource enumConverter}}" IsReadOnly="True" Width="1*" />
                            <DataGridTextColumn Header="Цена" Binding="{Binding Price, Mode=TwoWay, StringFormat='{}{0:C}'}" Width="1*" />
							<DataGridTextColumn Header="На складе" Binding="{Binding StockQuantity, Mode=TwoWay}" Width="1*" />
							<DataGridCheckBoxColumn Header="Активен" Binding="{Binding IsActive}" IsReadOnly="True" Width="1*" />
                        </DataGrid.Columns>
                    </DataGrid>

					<StackPanel Grid.Row="2" Orientation="Horizontal">
						<Button Content="Деактивировать выбранный товар"
                                 Width="250" Height="36"
                                 HorizontalAlignment="Left"
                                 Margin="5"
						        Style="{StaticResource DangerButton}"
                                Command="{Binding DeactivateProductCommand}" />

						<Button
                             Content="Активировать выбранный товар"
                             Width="250" Height="36"
                             HorizontalAlignment="Left"
                             Margin="5"
						    Style="{StaticResource BaseButton}"
                            Command="{Binding ActivateProductCommand}" />
					</StackPanel>

                

                    <!-- Блок добавления нового товара -->
					<GroupBox Grid.Row="3" Header="Добавить новый товар" Foreground="{StaticResource TextMutedBrush}" Margin="0,15,0,0" Padding="15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Название:" VerticalAlignment="Center" Margin="0,0,5,5" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding NewProductName, UpdateSourceTrigger=PropertyChanged}" Height="25" Margin="0,0,15,5" />

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Цена:" VerticalAlignment="Center" Margin="0,0,5,5" />
                            <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding NewProductPrice, UpdateSourceTrigger=PropertyChanged}" Height="25" Margin="0,0,0,5" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Описание:" VerticalAlignment="Center" Margin="0,0,5,5" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NewProductDescription, UpdateSourceTrigger=PropertyChanged}" Height="25" Margin="0,0,15,5" />

                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Остаток:" VerticalAlignment="Center" Margin="0,0,5,5" />
                            <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding NewProductStockQuantity, UpdateSourceTrigger=PropertyChanged}" Height="25" Margin="0,0,0,5" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Категория:" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding NewProductCategory}" Height="25" Margin="0,0,15,0" />

							<Button Grid.Row="2" Grid.Column="3"
                                    Content="Добавить товар"
                                    Height="34"
									Margin="0,10,0,5"
									Style="{StaticResource SuccessButton}"
                                    Command="{Binding AddProductCommand}" />
                        </Grid>
                    </GroupBox>

                </Grid>
            </TabItem>

            <TabItem Header="Заказы">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0"
                            Content="Обновить список"
                            Width="150" Height="35"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,12"
                            Style="{StaticResource BaseButton}"
                            Command="{Binding RefreshOrdersCommand}" />

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Orders}"
                              SelectedItem="{Binding SelectedOrder}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
							  CanUserResizeRows="True"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Номер" Binding="{Binding Id}" Width="1*" />
                            <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Width="2*" />
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="1*" />
                            <DataGridTextColumn Header="Сумма" Binding="{Binding TotalPrice, StringFormat='{}{0:C}'}" Width="1*" />
							<DataGridTextColumn Header="Товары" Binding="{Binding ProductsSummary}" Width="4*" >
								<DataGridTextColumn.ElementStyle>
									<Style TargetType="TextBlock">
										<Setter Property="TextWrapping" Value="Wrap"></Setter>
									</Style>
								</DataGridTextColumn.ElementStyle>
							</DataGridTextColumn>
						</DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal"
                                HorizontalAlignment="Left" Margin="0,10,0,0">
                        <TextBlock Text="Новый статус:"
								   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />
						<ComboBox ItemsSource="{Binding Statuses}"
                                  SelectedItem="{Binding SelectedStatus}"
                                  Width="180" Height="25" Margin="0,0,15,0" >
							<ComboBox.ItemTemplate>
								<DataTemplate>
									<TextBlock Text="{Binding Converter={StaticResource enumConverter}}" />
								</DataTemplate>
							</ComboBox.ItemTemplate>
						</ComboBox>
						<Button Content="Применить"
                                Width="120" Height="32"
								Style="{StaticResource SuccessButton}"
                                Command="{Binding ChangeOrderStatusCommand}" />
                    </StackPanel>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>