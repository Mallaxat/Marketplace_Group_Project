<Window x:Class="Marketplace_Group_Project.Views.AdminMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:converters="clr-namespace:Marketplace_Group_Project.Converters"
        mc:Ignorable="d"
        Title="Магазин — Администратор"
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
		Background="#F4F6F9"
        FontFamily="Segoe UI">

	<Window.Resources>
		<ResourceDictionary>
			<converters:EnumDescriptionConverter x:Key="enumConverter"/>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/Dictionaries/ViewsDictionary.xaml"/>
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Window.Resources>
	
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
		<Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderSoftBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16,10"
                Margin="0,0,0,12">
			<DockPanel>
				<Button DockPanel.Dock="Right"
                    Content="Выйти"
                    Width="100" Height="32"
					Style="{StaticResource GhostButton}"
                    Command="{Binding LogoutCommand}" />
				<TextBlock Text="{Binding CurrentUserName, StringFormat='Администратор: {0}'}"
                       VerticalAlignment="Center"
                       FontSize="15" FontWeight="Bold"
					   Foreground="{StaticResource TextPrimaryBrush}"/>
			</DockPanel>
		</Border>

		<!-- Вкладки -->
        <TabControl Grid.Row="1">

            <!-- ТОВАРЫ -->
            <TabItem Header="Товары">
				<Grid Margin="4,12,4,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0"
                            Content="Обновить список"
                            Width="160" Height="32"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,12"
							Style="{StaticResource BaseButton}"
                            Command="{Binding RefreshProductsCommand}" />

					<Border Grid.Row="1"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderSoftBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="1">
						
						<DataGrid ItemsSource="{Binding Products}"
                              SelectedItem="{Binding SelectedProduct}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
						      BorderThickness="0">
							<DataGrid.Columns>
								<DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="2*" />
								<DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="3*" />
								<DataGridTextColumn Header="Категория" Binding="{Binding Category, Converter={StaticResource enumConverter}}" Width="1*" />
								<DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat='{}{0:C}'}" Width="1*" />
								<DataGridTextColumn Header="На складе" Binding="{Binding StockQuantity}" Width="1*" />
								<DataGridCheckBoxColumn Header="Активен" Binding="{Binding IsActive}" Width="1*" />
							</DataGrid.Columns>
						</DataGrid>
					</Border>
					
					<Button Grid.Row="2"
                            Content="Деактивировать выбранный товар"
                            Width="260" Height="34"
                            HorizontalAlignment="Left"
                            Margin="0,12,0,0"
                            Style="{StaticResource DangerButton}"
                            Command="{Binding DeactivateProductCommand}" />
                </Grid>
            </TabItem>

            <!-- ЗАКАЗЫ -->
            <TabItem Header="Заказы">
				<Grid Margin="4,12,4,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0"
                            Content="Обновить список"
                            Width="160" Height="32"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,12"
                            Style="{StaticResource BaseButton}"
                            Command="{Binding RefreshOrdersCommand}" />

					<Border Grid.Row="1"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderSoftBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="1">
						
						<DataGrid ItemsSource="{Binding Orders}"
                              SelectedItem="{Binding SelectedOrder}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
							  BorderThickness="0">
							<DataGrid.Columns>
								<DataGridTextColumn Header="Номер" Binding="{Binding Id}" Width="1*" />
								<DataGridTextColumn Header="Пользователь" Binding="{Binding UserId}" Width="1*" />
								<DataGridTextColumn Header="Дата" Binding="{Binding CreatedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Width="2*" />
								<DataGridTextColumn Header="Статус" Binding="{Binding Status, Converter={StaticResource enumConverter}}" Width="1*" />
								<DataGridTextColumn Header="Сумма" Binding="{Binding TotalPrice, StringFormat='{}{0:C}'}" Width="1*" />
							</DataGrid.Columns>
						</DataGrid>
					</Border>


					<Border Grid.Row="2"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderSoftBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12,10"
                            Margin="0,12,0,0">
						
						<StackPanel Orientation="Horizontal">
							<TextBlock Text="Новый статус:"
                                   VerticalAlignment="Center" Margin="0,0,10,0" 
								   Foreground="{StaticResource TextMutedBrush}"/>
							<ComboBox ItemsSource="{Binding Statuses}"
                                  SelectedItem="{Binding SelectedStatus}"
                                  Width="200" Height="30" Margin="0,0,15,0" >
								<ComboBox.ItemTemplate>
									<DataTemplate>
										<TextBlock Text="{Binding Converter={StaticResource enumConverter}}" />
									</DataTemplate>
								</ComboBox.ItemTemplate>
							</ComboBox>
							<Button Content="Применить"
                                 Width="130" Height="32"
                                 Style="{StaticResource BaseButton}"
                                 Command="{Binding ChangeOrderStatusCommand}" />
						</StackPanel>
					</Border>
				</Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>