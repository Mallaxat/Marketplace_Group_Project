<Window x:Class="Marketplace_Group_Project.Views.AdminMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Магазин — Администратор"
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right"
                    Content="Выйти"
                    Width="100" Height="30"
                    Command="{Binding LogoutCommand}" />
            <TextBlock Text="{Binding CurrentUserName, StringFormat='Администратор: {0}'}"
                       VerticalAlignment="Center"
                       FontSize="14" FontWeight="Bold" />
        </DockPanel>

        <!-- Вкладки -->
        <TabControl Grid.Row="1">

            <!-- ТОВАРЫ -->
            <TabItem Header="Товары">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0"
                            Content="Обновить список"
                            Width="150" Height="25"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,10"
                            Command="{Binding RefreshProductsCommand}" />

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Products}"
                              SelectedItem="{Binding SelectedProduct}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="3*" />
                            <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="1*" />
                            <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat='{}{0:C}'}" Width="1*" />
                            <DataGridTextColumn Header="На складе" Binding="{Binding StockQuantity}" Width="1*" />
                            <DataGridCheckBoxColumn Header="Активен" Binding="{Binding IsActive}" Width="1*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Grid.Row="2"
                            Content="Деактивировать выбранный товар"
                            Width="250" Height="30"
                            HorizontalAlignment="Left"
                            Margin="0,10,0,0"
                            Command="{Binding DeactivateProductCommand}" />
                </Grid>
            </TabItem>

            <!-- ЗАКАЗЫ -->
            <TabItem Header="Заказы">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0"
                            Content="Обновить список"
                            Width="150" Height="25"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,10"
                            Command="{Binding RefreshOrdersCommand}" />

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Orders}"
                              SelectedItem="{Binding SelectedOrder}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Номер" Binding="{Binding Id}" Width="1*" />
                            <DataGridTextColumn Header="Пользователь" Binding="{Binding UserId}" Width="1*" />
                            <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Width="2*" />
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="1*" />
                            <DataGridTextColumn Header="Сумма" Binding="{Binding TotalPrice, StringFormat='{}{0:C}'}" Width="1*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal"
                                HorizontalAlignment="Left" Margin="0,10,0,0">
                        <TextBlock Text="Новый статус:"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                        <ComboBox ItemsSource="{Binding Statuses}"
                                  SelectedItem="{Binding SelectedStatus}"
                                  Width="180" Height="25" Margin="0,0,15,0" />
                        <Button Content="Применить"
                                Width="120" Height="25"
                                Command="{Binding ChangeOrderStatusCommand}" />
                    </StackPanel>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>