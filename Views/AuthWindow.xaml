<Window x:Class="Marketplace_Group_Project.Views.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Marketplace_Group_Project.Converters"
        mc:Ignorable="d"
        Title="Авторизация / Регистрация"
        Height="450" Width="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <local:BoolToSwitchTextConverter x:Key="BoolToSwitchTextConverter" />
        <local:NonEmptyStringToVisibilityConverter x:Key="NonEmptyStringToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0"
                   FontSize="20"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="Вход"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRegistrationMode}" Value="True">
                            <Setter Property="Text" Value="Регистрация"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Login -->
        <StackPanel Grid.Row="1" Margin="0,5">
            <TextBlock Text="Логин" FontWeight="SemiBold" Foreground="#333333"/>
            <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"
                     Height="28" Margin="0,4" Padding="5,0"/>
        </StackPanel>

        <!-- Email (при регистрации) -->
        <StackPanel Grid.Row="2" Margin="0,5"
                    Visibility="{Binding IsRegistrationMode, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="Email" FontWeight="SemiBold" Foreground="#333333"/>
            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                     Height="28" Margin="0,4" Padding="5,0"/>
        </StackPanel>

        <!-- Password -->
        <StackPanel Grid.Row="3" Margin="0,5">
            <TextBlock Text="Пароль" FontWeight="SemiBold" Foreground="#333333"/>
            <PasswordBox x:Name="PwdBox"
                         Height="28" Margin="0,4" Padding="5,0"
                         PasswordChanged="PwdBox_PasswordChanged"/>
        </StackPanel>

        <!-- RepeatPassword (при регистрации) -->
        <StackPanel Grid.Row="4" Margin="0,5"
                    Visibility="{Binding IsRegistrationMode, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="Повторите пароль" FontWeight="SemiBold" Foreground="#333333"/>
            <PasswordBox x:Name="RepeatPwdBox"
                         Height="28" Margin="0,4" Padding="5,0"
                         PasswordChanged="RepeatPwdBox_PasswordChanged"/>
        </StackPanel>

        <!-- Блок ввода кода (только в режиме подтверждения) -->
        <StackPanel Grid.Row="5" Margin="0,5"
            Visibility="{Binding IsConfirmationMode, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="Код подтверждения" FontWeight="SemiBold" Foreground="#333333"/>
            <TextBox Text="{Binding ConfirmationCode, UpdateSourceTrigger=PropertyChanged}"
             Height="28" Margin="0,4" Padding="5,0"/>
        </StackPanel>

        <!-- Кнопка "Подтвердить" (только в режиме подтверждения) -->
        <Button Grid.Row="6"
        Content="Подтвердить"
        Command="{Binding ConfirmCodeCommand}"
        Height="34" Margin="0,15,0,5"
        Visibility="{Binding IsConfirmationMode, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <!-- Кнопка "Зарегистрироваться" скрывается, если включён режим подтверждения -->
        <Button Grid.Row="6"
        Content="Зарегистрироваться"
        Command="{Binding RegisterCommand}"
        Height="34" Margin="0,15,0,5"
        Visibility="{Binding IsRegistrationMode, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <!-- Войти (только в режиме входа) -->
        <Button Grid.Row="7"
                Content="Войти"
                Command="{Binding LoginCommand}"
                Height="34"
                Margin="0,15,0,5"
                Visibility="{Binding IsRegistrationMode, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

        <!-- Зарегистрироваться (только в режиме регистрации) --><!--
        <Button Grid.Row="8"
                Content="Зарегистрироваться"
                Command="{Binding RegisterCommand}"
                Height="34"
                Margin="0,15,0,5"
                Visibility="{Binding IsRegistrationMode, Converter={StaticResource BoolToVisibilityConverter}}"/>-->

        <!-- Переключатель режима -->
        <TextBlock Grid.Row="8"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,0">
            <Hyperlink Command="{Binding SwitchModeCommand}">
                <TextBlock Text="{Binding IsRegistrationMode, Converter={StaticResource BoolToSwitchTextConverter}}"/>
            </Hyperlink>
        </TextBlock>

        <!-- ErrorMessage -->
        <TextBlock Grid.Row="9"
                   Text="{Binding ErrorMessage}"
                   Foreground="Red"
                   FontSize="13"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   Margin="0,12,0,0"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NonEmptyStringToVisibilityConverter}}"/>
    </Grid>
</Window>
