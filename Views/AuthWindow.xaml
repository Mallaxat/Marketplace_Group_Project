<Window x:Class="Marketplace_Group_Project.Views.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Marketplace_Group_Project.Converters"
        mc:Ignorable="d"
        Title="Авторизация / Регистрация"
        Height="520" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
		Background="#F4F6F9"
        FontFamily="Segoe UI">

    <Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/Dictionaries/ViewsDictionary.xaml"/>
			</ResourceDictionary.MergedDictionaries>

			<BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
			<local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
			<local:BoolToSwitchTextConverter x:Key="BoolToSwitchTextConverter" />
			<local:NonEmptyStringToVisibilityConverter x:Key="NonEmptyStringToVisibilityConverter" />
		</ResourceDictionary>
	</Window.Resources>


	<Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderSoftBrush}"
            BorderThickness="1" CornerRadius="14"
            Margin="24" Padding="24,22">
		<Border.Effect>
            <DropShadowEffect Color="#1F2937" BlurRadius="18" ShadowDepth="2" Opacity="0.08"/>
        </Border.Effect>
	
	
        <Grid Margin="20" >
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
			<StackPanel Grid.Row="0" Margin="0,0,0,18">
				<TextBlock FontSize="22"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
					   Foreground="{StaticResource TextPrimaryBrush}">
					<TextBlock.Style>
						<Style TargetType="TextBlock">
							<Setter Property="Text" Value="Вход"/>
							<Style.Triggers>
								<DataTrigger Binding="{Binding IsRegistrationMode}" Value="True">
									<Setter Property="Text" Value="Регистрация"/>
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</TextBlock.Style>
				</TextBlock>
			</StackPanel>
			
			<!-- Login -->
			<StackPanel Grid.Row="1" Margin="0,0,0,10">
				<TextBlock Text="Логин" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <!-- Email (при регистрации) -->
			<StackPanel Grid.Row="2" Margin="0,0,0,10"
                        Visibility="{Binding IsRegistrationMode, Converter={StaticResource BoolToVisibilityConverter}}">
				<TextBlock Text="Email" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <!-- Password -->
			<StackPanel Grid.Row="3"  Margin="0,0,0,10">
				<TextBlock Text="Пароль" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="PwdBox" PasswordChanged="PwdBox_PasswordChanged"/>
            </StackPanel>

            <!-- RepeatPassword (при регистрации) -->
			<StackPanel Grid.Row="4"  Margin="0,0,0,10"
                        Visibility="{Binding IsRegistrationMode, Converter={StaticResource BoolToVisibilityConverter}}">
				<TextBlock Text="Повторите пароль" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="RepeatPwdBox"
                             PasswordChanged="RepeatPwdBox_PasswordChanged"/>
            </StackPanel>

            <!-- Блок ввода кода (только в режиме подтверждения) -->
			<StackPanel Grid.Row="5"  Margin="0,0,0,10"
                Visibility="{Binding IsConfirmationMode, Converter={StaticResource BoolToVisibilityConverter}}">
				<TextBlock Text="Код подтверждения" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding ConfirmationCode, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <!-- Кнопка "Подтвердить" (только в режиме подтверждения) -->
			<Button Grid.Row="6"
                Content="Подтвердить"
                Command="{Binding ConfirmCodeCommand}"
                Height="36" Margin="0,10,0,4"
                Style="{StaticResource BaseButton}"
                Visibility="{Binding IsConfirmationMode, Converter={StaticResource BoolToVisibilityConverter}}"/>

			<!-- Кнопка "Зарегистрироваться" скрывается, если включён режим подтверждения -->
			<Button Grid.Row="6"
                Content="Зарегистрироваться"
                Command="{Binding RegisterCommand}"
                Height="36" Margin="0,10,0,4"
                Style="{StaticResource BaseButton}"
                Visibility="{Binding IsRegistrationMode, Converter={StaticResource BoolToVisibilityConverter}}"/>

			<!-- Войти (только в режиме входа) -->
            <Button Grid.Row="7"
                    Content="Войти"
                    Command="{Binding LoginCommand}"
                    Height="36"
                    Margin="0,10,0,4"
                    Style="{StaticResource BaseButton}"
                    Visibility="{Binding IsRegistrationMode, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

            <!-- Зарегистрироваться (только в режиме регистрации) --><!--
            <Button Grid.Row="8"
                    Content="Зарегистрироваться"
                    Command="{Binding RegisterCommand}"
                    Height="34"
                    Margin="0,15,0,5"
                    Visibility="{Binding IsRegistrationMode, Converter={StaticResource BoolToVisibilityConverter}}"/>-->

            <!-- Переключатель режима -->
            <TextBlock Grid.Row="8"
                       HorizontalAlignment="Center"
                       Margin="0,12,0,0"
                       FontSize="13"
                       Foreground="{StaticResource TextMutedBrush}">
                <Hyperlink Command="{Binding SwitchModeCommand}">
                    <TextBlock Text="{Binding IsRegistrationMode, Converter={StaticResource BoolToSwitchTextConverter}}"/>
                </Hyperlink>
            </TextBlock>

            <!-- ErrorMessage -->
			<Border Grid.Row="9"
                    Background="#FDECEC"
                    BorderBrush="#F5B7B8"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,8"
                    Margin="0,14,0,0"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NonEmptyStringToVisibilityConverter}}">
				
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource DangerBrush}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"/>
			</Border>
		
		</Grid>

	</Border>
</Window>
