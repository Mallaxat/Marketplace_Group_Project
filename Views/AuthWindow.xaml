<Window x:Class="Marketplace_Group_Project.Views.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:Marketplace_Group_Project.Converters"
        mc:Ignorable="d"
        Title="Авторизация / Регистрация"
        Height="700" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
		Background="#F4F6F9"
        FontFamily="Segoe UI">

    <Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/Dictionaries/ViewsDictionary.xaml"/>
			</ResourceDictionary.MergedDictionaries>

			<BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
            <converters:BoolToSwitchTextConverter x:Key="BoolToSwitchTextConverter" />
            <converters:NonEmptyStringToVisibilityConverter x:Key="NonEmptyStringToVisibilityConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <converters:InverseBoolConverter x:Key="EnumToBoolConverter"/>
		</ResourceDictionary>
	</Window.Resources>

	<ScrollViewer VerticalScrollBarVisibility="Auto">
		<Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderSoftBrush}"
            BorderThickness="1" CornerRadius="14"
            Margin="24" Padding="24,22">
			<Border.Effect>
				<DropShadowEffect Color="#1F2937" BlurRadius="18" ShadowDepth="2" Opacity="0.08"/>
			</Border.Effect>

			<Grid Margin="20" >
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<!-- Заголовок -->
				<StackPanel Grid.Row="0" Margin="0,0,0,18">
					<TextBlock FontSize="22"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
					   Foreground="{StaticResource TextPrimaryBrush}">
						<TextBlock.Style>
							<Style TargetType="TextBlock">
								<Setter Property="Text" Value="Вход"/>
								<Style.Triggers>
									<DataTrigger Binding="{Binding IsRegistrationMode}" Value="True">
										<Setter Property="Text" Value="Регистрация"/>
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</TextBlock.Style>
					</TextBlock>
				</StackPanel>

                <!-- Выбор роли (только при регистрации) -->
                <WrapPanel Grid.Row="1" Margin="0,5,0,15" Orientation="Horizontal" Visibility="{Binding IsRegistrationMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Вы:" Style="{StaticResource FieldLabel}" Margin="20,0,10,0" VerticalAlignment="Center" FontSize="16"/>
                    <RadioButton Content="Покупатель" IsChecked="{Binding IsCustomerRole, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="16"/>
                    <RadioButton Content="Продавец" IsChecked="{Binding IsSellerRole, Mode=TwoWay}" VerticalAlignment="Center" FontSize="16"/>
                </WrapPanel>

                <!-- Login -->
				<StackPanel Grid.Row="2" Margin="0,0,0,10">
					<TextBlock Text="Логин" Style="{StaticResource FieldLabel}"/>
					<TextBox Name="txt_login" Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
				</StackPanel>

				<!-- Email (при регистрации) -->
				<StackPanel Grid.Row="3" Margin="0,0,0,10"
                        Visibility="{Binding IsRegistrationMode, Converter={StaticResource BoolToVisibilityConverter}}">
					<TextBlock Text="Email" Style="{StaticResource FieldLabel}"/>
					<TextBox Name="txt_email" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
				</StackPanel>

				<!-- Password -->
				<StackPanel Grid.Row="4"  Margin="0,0,0,10">
					<TextBlock Text="Пароль" Style="{StaticResource FieldLabel}"/>
					<PasswordBox x:Name="PwdBox" PasswordChanged="PwdBox_PasswordChanged"/>
				</StackPanel>

				<!-- RepeatPassword (при регистрации) -->
				<StackPanel Grid.Row="5"  Margin="0,0,0,10"
                        Visibility="{Binding IsRegistrationMode, Converter={StaticResource BoolToVisibilityConverter}}">
					<TextBlock Text="Повторите пароль" Style="{StaticResource FieldLabel}"/>
					<PasswordBox x:Name="RepeatPwdBox" PasswordChanged="RepeatPwdBox_PasswordChanged"/>
				</StackPanel>

                <!-- Блок ввода кода (только в режиме подтверждения) -->
				<StackPanel Grid.Row="6"  Margin="0,0,0,10"
                Visibility="{Binding IsConfirmationMode, Converter={StaticResource BoolToVisibilityConverter}}">
					<TextBlock Text="Код подтверждения" Style="{StaticResource FieldLabel}"/>
					<TextBox Name="txt_code" Text="{Binding ConfirmationCode, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
				</StackPanel>

				<!-- Кнопка "Подтвердить" (только в режиме подтверждения) -->
				<Button Grid.Row="7"
				Name="btn_confirm"
                Content="Подтвердить"
                Command="{Binding ConfirmCodeCommand}"
                Height="36" Margin="0,10,0,4"
                Style="{StaticResource BaseButton}"
                Visibility="{Binding IsConfirmationMode, Converter={StaticResource BoolToVisibilityConverter}}"
				Click="btn_confirm_Click"/>

				<!-- Кнопка "Зарегистрироваться" скрывается, если включён режим подтверждения -->
				<Button Grid.Row="8"
                Content="Зарегистрироваться"
                Command="{Binding RegisterCommand}" 
                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                Height="36" Margin="0,10,0,4"
                Style="{StaticResource BaseButton}"
                Visibility="{Binding IsRegistrationMode, Converter={StaticResource BoolToVisibilityConverter}}"/>

				<!-- Войти (только в режиме входа) -->
				<Button Grid.Row="8"
                    Content="Войти"
                    Command="{Binding LoginCommand}"
                    IsDefault="True"
                    Height="36"
                    Margin="0,10,0,4"
                    Style="{StaticResource BaseButton}"
                    Visibility="{Binding IsRegistrationMode, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

				<!-- Переключатель режима -->
				<TextBlock Grid.Row="9"
                       HorizontalAlignment="Center"
                       Margin="0,12,0,0"
                       FontSize="13"
                       Foreground="{StaticResource TextMutedBrush}">
                <Hyperlink Command="{Binding SwitchModeCommand}" Click="Hyperlink_Click">
                    <TextBlock Text="{Binding IsRegistrationMode, Converter={StaticResource BoolToSwitchTextConverter}}"/>
                </Hyperlink>
            </TextBlock>

				<!-- ErrorMessage -->
				<Border Grid.Row="10"
                    Background="#FDECEC"
                    BorderBrush="#F5B7B8"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,8"
                    Margin="0,14,0,0"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NonEmptyStringToVisibilityConverter}}">

					<TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource DangerBrush}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"/>
				</Border>
			</Grid>
		</Border>
	</ScrollViewer>
</Window>
