<Window x:Class="Marketplace_Group_Project.Views.UserMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Магазин — Покупатель"
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right"
                    Content="Выйти"
                    Width="100" Height="30"
                    Command="{Binding LogoutCommand}" />
            <TextBlock Text="{Binding CurrentUserName, StringFormat='Пользователь: {0}'}"
                       VerticalAlignment="Center"
                       FontSize="14" FontWeight="Bold" />
        </DockPanel>

        <!-- Вкладки -->
        <TabControl Grid.Row="1">

            <!-- ТОВАРЫ -->
            <TabItem Header="Товары">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Width="200" Height="25" Margin="0,0,15,0" />

                        <TextBlock Text="Категория:" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <ComboBox ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding SelectedCategory}"
                                  Width="180" Height="25" Margin="0,0,15,0" />

                        <Button Content="Сбросить"
                                Width="100" Height="25"
                                Command="{Binding ResetFilterCommand}" />
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding FilteredProducts}"
                              SelectedItem="{Binding SelectedProduct}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="3*" />
                            <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="1*" />
                            <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat='{}{0:C}'}" Width="1*" />
                            <DataGridTextColumn Header="На складе" Binding="{Binding StockQuantity}" Width="1*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Grid.Row="2"
                            Content="Добавить в корзину"
                            Width="200" Height="30"
                            HorizontalAlignment="Left"
                            Margin="0,10,0,0"
                            Command="{Binding AddToCartCommand}" />
                </Grid>
            </TabItem>

            <!-- КОРЗИНА -->
            <TabItem Header="Корзина">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0"
                              ItemsSource="{Binding CartItems}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Товар" Binding="{Binding Product.Name}" Width="3*" />
                            <DataGridTextColumn Header="Цена" Binding="{Binding Product.Price, StringFormat='{}{0:C}'}" Width="1*" />
                            <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="1*" />
                            <DataGridTemplateColumn Header="Действия" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="+"
                                                    Width="30" Height="25" Margin="2"
                                                    Command="{Binding DataContext.IncreaseQuantityCommand,
                                                              RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="−"
                                                    Width="30" Height="25" Margin="2"
                                                    Command="{Binding DataContext.DecreaseQuantityCommand,
                                                              RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Удалить"
                                                    Width="80" Height="25" Margin="2"
                                                    Command="{Binding DataContext.RemoveFromCartCommand,
                                                              RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="0,10,0,0">
                        <TextBlock Text="{Binding CartTotal, StringFormat='Итого: {0:C}'}"
                                   FontSize="16" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="0,0,20,0" />
                        <Button Content="Оформить заказ"
                                Width="150" Height="30"
                                Command="{Binding CheckoutCommand}" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- МОИ ЗАКАЗЫ -->
            <TabItem Header="Мои заказы">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0"
                            Content="Обновить"
                            Width="120" Height="25"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,10"
                            Command="{Binding RefreshOrdersCommand}" />

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding UserOrders}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Номер" Binding="{Binding Id}" Width="1*" />
                            <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Width="2*" />
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="1*" />
                            <DataGridTextColumn Header="Сумма" Binding="{Binding TotalPrice, StringFormat='{}{0:C}'}" Width="1*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>